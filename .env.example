# ==============================================================================
# AI LOAN ELIGIBILITY CHECKER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# Never commit real credentials or .env to version control.

# Application Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500"

# Anthropic Claude API (Optional for deterministic calculations; required for AI analysis)
# Obtain from https://console.anthropic.com
CLAUDE_API_KEY=

# Google Sheets Audit Integration (Optional; if unset, system runs in local fallback mode)
# 1. Create a Google Cloud Project with Google Sheets API enabled
# 2. Create a Service Account and download JSON credentials
# 3. Share the Google Sheet with the Service Account email as Editor
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
